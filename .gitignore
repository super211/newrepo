# Local Claude Code configuration — machine-specific, not part of the site
.claude/

# Editor / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Build output (the gh-pages branch is generated by CI, never committed here)
_site/

